<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.channelf.gnome</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go Channel F (GNOME)</name>
  <summary>Fairchild Channel F with a built-in FujiNet cartridge</summary>
  <description>
    <p>
      A self-contained Fairchild Channel F, the 1976 console with the F8
      microprocessor and the first programmable cartridges, the Videocarts,
      with a FujiNet built in: browse a network host from the console, boot
      games and programs over the network, and let a FujiNet program keep
      talking to the network, all in one application.
    </p>
    <p>
      FujiNet's CONFIG program is built in and starts at power-on, exactly as
      on the FujiNet Channel F cartridge. Local cartridge images (.bin, .chf,
      or a zip holding one) can be opened in its place, or imported to
      FujiNet's SD folder with Import Cartridge to SD and booted from CONFIG.
      The Channel F, the System II and the Saba Videoplay PAL consoles are
      offered.
    </p>
    <p>
      The emulator is MAME's Channel F and its F8 CPU transposed to C, with the
      FujiNet cartridge running the real cartridge firmware's own protocol and
      bus sources, so it behaves as the hardware does.
    </p>
    <p>
      The Controllers window draws both hand controllers with all four of the
      knob's axes (tilt in eight directions, twist either way, pull up and push
      down) and the console's RESET, TIME, MODE, HOLD and START buttons; click,
      drag, scroll to twist, and Map rebinds any of them to a key or a gamepad
      button. A gamepad's right stick twists and pulls. A native debugger has a
      command prompt, the F8's registers, scratchpad and K stack with a memory
      viewer, disassembly with breakpoints, a Video tab that shows the whole
      128 by 64 video memory with each row's palette, the hidden columns, the
      four ports and every write, the sound and the controllers, and the
      FujiNet cartridge with every FujiBus packet on its link. The built-in
      Help covers all of it.
    </p>
    <p>
      Nothing copyrighted is included. FujiNet programs run on the app's own
      stand-in BIOS; Videocarts need the console's BIOS, which you import from
      your own dumps.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.channelf.gnome.desktop</launchable>
  <icon type="stock">online.fujinet.go.channelf.gnome</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-channelf-desktop/issues</url>
  <url type="vcs-browser">https://github.com/FujiNetWIFI/fujinet-go-channelf-desktop</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>The FujiNet CONFIG client running on the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-channelf-desktop/v0.1.0/data/screenshots/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's Video tab: the video memory, its palettes and the ports</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-channelf-desktop/v0.1.0/data/screenshots/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>The Controllers window: both hand controllers and the console's buttons</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-channelf-desktop/v0.1.0/data/screenshots/3_controllers.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-11-05">
      <description>
        <p>
          First release: the Fairchild Channel F transposed from MAME, with
          the FujiNet Channel F cartridge and an in-process FujiNet; BIOS
          import, a Controllers window with both hand controllers' four axes,
          gamepads, a native debugger with a full Channel F video tab and a
          FujiNet tab, and built-in Help.
        </p>
      </description>
    </release>
  </releases>
</component>
