<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>FujiNet Go Channel F</string>
  <key>CFBundleDisplayName</key>
  <string>FujiNet Go Channel F</string>
  <key>CFBundleIdentifier</key>
  <string>online.fujinet.go.channelf.macos</string>
  <key>CFBundleExecutable</key>
  <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIconFile</key>
  <string>${MACOSX_BUNDLE_ICON_FILE}</string>
  <key>CFBundleShortVersionString</key>
  <string>${PROJECT_VERSION}</string>
  <key>CFBundleVersion</key>
  <string>${PROJECT_VERSION}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.3</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.games</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 Thomas Cherryhomes. GPL-3.0-or-later.</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <!-- .chf is the Channel F cartridge dump's own extension, so the app owns
       it. A raw .bin is every other machine's too: the app takes it as an
       alternate (listed in Finder's Open With, never the default), as it does
       a zip holding one cartridge image. (.rom is the BIOS's extension, not a
       cartridge's: a dropped BIOS is imported, so it is not listed.) No UTI
       is invented for any of them: Launch Services matches by extension. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Fairchild Channel F cartridge image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>chf</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Raw cartridge image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>bin</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Zipped Channel F cartridge</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>zip</string>
      </array>
    </dict>
  </array>
  <!-- The FujiNet web UI is plain HTTP on loopback. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
